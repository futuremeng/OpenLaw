# 数据目录整体可迁移，内容严禁提交（开发文档 7、9.1）；仅保留目录骨架
data/**
!data/**/
!data/**/.gitkeep
*.db
*.db-wal
*.db-shm

# 签名私钥严禁进入仓库（开发文档 16.2）
*.key
keys/

# 构建产物（仅仓库根；desktop/frontend/dist 是随应用嵌入的前端资产，必须入库）
bin/
/dist/

# wails dev 产物（wails dev 在 desktop/ 下运行：build/bin 临时二进制、
# build/wailsjs 自动绑定生成物——前端不用 wailsjs 模块，生成物不入库）
desktop/build/

# Delve/Wails 调试产物
__debug_bin*

# 系统与编辑器
.DS_Store
.idea/
*.log
.vscode/settings.local.json

# wails dev 绑定探测时以 desktop/ 为工作目录产生的临时数据（真实库在项目根 data/）
desktop/data/
