{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "go test: all",
      "type": "shell",
      "command": "go test ./... -count=1",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "gates: fmt+build+vet+test",
      "type": "shell",
      "command": "gofmt -l . && go build ./... && go build -tags desktop,production -o /dev/null ./desktop && go vet ./... && go test ./... -count=1",
      "group": "build",
      "problemMatcher": []
    },
    {
      // 桌面端发布形态构建（wails 必须带 desktop,production 标签；cgo 链接指令已在源码内）。
      "label": "build: openlaw-desktop",
      "type": "shell",
      "command": "go build -tags desktop,production -o dist/openlaw-desktop ./desktop",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      // 打包形态调试支撑：在 OpenCourt 产出带调试符号的 .app。
      "label": "oc: wails build -debug",
      "type": "shell",
      "command": "wails build -debug",
      "options": {
        "cwd": "${workspaceFolder}/../OpenCourt",
        "env": {
          "PATH": "${env:PATH}:${env:HOME}/go/bin",
          "GOPROXY": "https://goproxy.cn,direct"
        }
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      // 桌面端联调支撑任务：在兄弟仓库 OpenCourt 里跑 wails dev 并附加 Delve。
      "label": "oc: wails dev",
      "type": "shell",
      "command": "wails dev",
      "options": {
        "cwd": "${workspaceFolder}/../OpenCourt",
        "env": {
          "PATH": "${env:PATH}:${env:HOME}/go/bin",
          "GOPROXY": "https://goproxy.cn,direct"
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "wails-oc",
        "fileLocation": ["relative", "${workspaceFolder}/../OpenCourt"],
        "pattern": {
          "regexp": "^(.*\\.go):(\\d+):(\\d+):\\s+(\\w+):\\s+(.*)$",
          "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\s*•?\\s*(Building|Installing|Compiling).*",
          "endsPattern": "(Running application|DevServer listening on).*"
        }
      }
    },
    {
      "label": "oc: dlv attach",
      "type": "shell",
      "command": "until PID=$(pgrep -x OpenCourt | head -1) && [ -n \"$PID\" ]; do sleep 1; done; dlv attach \"$PID\" --headless --listen=127.0.0.1:2346 --api-version=2",
      "options": {
        "env": {
          "PATH": "${env:PATH}:${env:HOME}/go/bin"
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "delve-oc",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "API server listening at.*"
        }
      }
    },
    {
      "label": "oc: start wails dev then dlv",
      "dependsOrder": "sequence",
      "dependsOn": ["oc: wails dev", "oc: dlv attach"],
      "problemMatcher": []
    },
    {
      "label": "build: openlaw-eu-text",
      "type": "shell",
      "command": "go build -o /tmp/openlaw-eu-text ./cmd/openlaw-eu-text",
      "group": "build",
      "problemMatcher": []
    }
  ]
}
