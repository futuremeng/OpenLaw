<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS 应用包描述文件（由 packaging/macos/build-app.sh 复制进 .app/Contents/）。

  为什么必须有：TCC（系统权限）只认带 bundle 身份且已签名的应用；裸二进制没有
  身份，navigator.geolocation 一律被拒。缺少 NSLocation* 用途声明时，系统不会
  弹出授权窗，CoreLocation 也不会进入「已决定」状态。

  用途声明必须如实：仅用于本机离线判定当前地区。坐标由系统定位服务给出（macOS
  可能经由其 Wi-Fi 定位数据库），本应用不上传数据、不做 IP 定位、不调用在线地理编码。
-->
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>OpenLaw</string>
	<key>CFBundleDisplayName</key>
	<string>开源法律法规数据库</string>
	<key>CFBundleIdentifier</key>
	<string>com.github.futuremeng.openlaw</string>
	<key>CFBundleExecutable</key>
	<string>OpenLaw</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>0.1.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>OpenLaw 需要读取一次本机坐标，用于在本机离线判定「当前地区」。坐标由系统定位服务给出（macOS 可能经由其 Wi-Fi 定位数据库）；本应用不上传任何数据、不做 IP 定位、不调用在线地理编码服务，判定结果可随时手动更正。</string>
	<key>NSLocationUsageDescription</key>
	<string>同上：坐标仅用于本机地区判定，本应用不上传数据。</string>
</dict>
</plist>
